{
  "name": "opencode-quotes-plugin",
  "version": "2.0.0",
  "description": "A motivational quotes plugin for OpenCode",
  "keywords": [
    "opencode",
    "opencode-cli",
    "opencode-ai",
    "opentui",
    "plugin",
    "motivational",
    "inspirational",
    "motivation",
    "inspiration",
    "quotes",
    "openai",
    "codex",
    "anthropic",
    "claude-code",
    "claude",
    "gemini",
    "copilot"
  ],
  "type": "module",
  "exports": {
    ".": {
